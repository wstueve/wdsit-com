# Environment variables for local development
# Copy this to .env and fill in your values
# DO NOT commit .env file to git!

# Node environment
NODE_ENV=development
PORT=8080

# Resend API key for email sending
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Stripe secret key. Checkout stays closed until this is set.
# The button tells the visitor to email support. It does not pretend a payment succeeded.
STRIPE_SECRET_KEY=sk_test_your_key_here

# 99700 while the first eight seats are open. Set to 120000 after those seats sell.
COURSE_PRICE_CENTS=99700

# Optional. Included in the receipt email when Resend is also configured.
BOOKING_URL=
