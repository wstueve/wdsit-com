{
	"name": "wdsit-com",
	"description": "Full-stack React Router 7 SSR application for Shopify plugin business.",
	"private": true,
	"dependencies": {
		"@react-router/express": "^8.3.0",
		"express": "^4.22.2",
		"express-rate-limit": "^8.5.2",
		"helmet": "^8.2.0",
		"isbot": "5.1.26",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^8.3.0",
		"resend": "^6.25.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.61.1",
		"@react-router/dev": "^8.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/express": "^5.0.0",
		"@types/node": "24.0.4",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"tailwindcss": "^4.3.3",
		"typescript": "5.8.3",
		"vite": "^8.2.0",
		"vite-tsconfig-paths": "^6.1.1"
	},
	"scripts": {
		"build": "react-router build",
		"check": "tsc && react-router build",
		"deploy": "gcloud run deploy svc-wdsit-com --source . --region=us-central1",
		"deploy:canary": "./.scripts/canary-deploy.sh",
		"dev": "react-router dev",
		"preview": "npm run build && node server.js",
		"start": "node server.js",
		"test": "playwright test",
		"test:headed": "playwright test --headed",
		"test:ui": "playwright test --ui",
		"test:deployment": "playwright test tests/deployment",
		"typecheck": "tsc -b"
	},
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=10.0.0"
	},
	"type": "module"
}
